{
  "name": "temene-fuzz",
  "version": "1.0.0",
  "description": "Jazzer.js fuzzing harnesses for the Temene / SeNest application",
  "private": true,
  "scripts": {
    "fuzz:jwt":        "jazzer fuzz/harnesses/01-jwt-verify.fuzz.ts      --corpus fuzz/corpus/01-jwt-verify      --dict fuzz/dicts/jwt.dict",
    "fuzz:query":      "jazzer fuzz/harnesses/02-query-transform.fuzz.ts  --corpus fuzz/corpus/02-query-transform  --dict fuzz/dicts/mongodb.dict",
    "fuzz:fileext":    "jazzer fuzz/harnesses/03-file-extension.fuzz.ts   --corpus fuzz/corpus/03-file-extension   --dict fuzz/dicts/filenames.dict",
    "fuzz:dto":        "jazzer fuzz/harnesses/04-dto-validation.fuzz.ts   --corpus fuzz/corpus/04-dto-validation   --dict fuzz/dicts/general.dict",
    "fuzz:objectid":   "jazzer fuzz/harnesses/05-objectid-parse.fuzz.ts   --corpus fuzz/corpus/05-objectid-parse   --dict fuzz/dicts/general.dict",
    "fuzz:bcrypt":     "jazzer fuzz/harnesses/06-bcrypt-hashpwd.fuzz.ts   --corpus fuzz/corpus/06-bcrypt-hashpwd   --dict fuzz/dicts/general.dict",
    "fuzz:login":      "jazzer fuzz/harnesses/07-login-logic.fuzz.ts      --corpus fuzz/corpus/07-login-logic      --dict fuzz/dicts/general.dict",
    
  },
  "dependencies": {
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^2.3.1",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^6.9.2",
    "mongodb-memory-server": "^8.12.2",
    "reflect-metadata": "^0.1.13"
  },
  "devDependencies": {
    "@jazzer.js/core": "^3.0.0",
    "@jazzer.js/jest-runner": "^3.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^18.0.0",
    "ts-node": "^10.9.1",
    "typescript": "~4.9.4"
  }
}
